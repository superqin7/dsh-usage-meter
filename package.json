{
  "name": "dsh-usage-meter",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Token usage and cost meter for DeepSeek Harness: today's tokens at the sidebar foot, an estimated cost panel one click away.",
  "license": "MIT",
  "author": "Super秦",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "token-usage",
    "cost-tracking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superqin7/dsh-usage-meter.git"
  },
  "homepage": "https://github.com/superqin7/dsh-usage-meter#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
